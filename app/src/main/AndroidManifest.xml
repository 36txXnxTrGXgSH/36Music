<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Aucune permission de stockage n'est demandée : les fichiers sont lus par SAF, à travers
        les dossiers que l'utilisateur choisit lui-même. C'est ce qui permet de ne rien analyser
        au premier démarrage.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Égaliseur et effets audio -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!--
        Aucune permission réseau : ni INTERNET (jamais demandée), ni l'état du réseau qu'ajoute
        media3 pour adapter le streaming, dont un lecteur de fichiers locaux n'a que faire —
        media3 tolère son absence. L'application ne peut ni se connecter, ni savoir si elle le
        pourrait.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <application
        android:name=".Music36App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/regles_extraction"
        android:fullBackupContent="@xml/regles_sauvegarde"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/nom_application"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Music36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.Music36">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Ouvrir un fichier audio depuis un explorateur -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/x-ogg" />
            </intent-filter>
        </activity>

        <!--
            Le partage des playlists exportées.

            ⚠️ `exported="false"` et `grantUriPermissions` : aucune application ne peut venir
            lire nos fichiers d'elle-même, seules celles à qui nous passons un URI le peuvent,
            fichier par fichier et le temps du partage.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.partage"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/chemins_partage" />
        </provider>

        <!--
            Le service de lecture survit à l'écran : c'est lui qui détient ExoPlayer et la
            MediaSession (notification, écran verrouillé, boutons du casque, Android Auto).
        -->
        <service
            android:name=".lecture.ServiceLecture"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
